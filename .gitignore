# ─────────────────────────────────────────────────────────────
# Skylinks Asia — local-only artefacts
# (never commit; these are regenerated by build/audit/prune)
# ─────────────────────────────────────────────────────────────

# Windows system junk
Desktop - Shortcut.lnk
*.lnk
Thumbs.db
Desktop.ini

# macOS junk (future-proofing)
.DS_Store

# Editor temp files
~$*
*.tmp
*.bak
*.swp
*.swo
*~

# prune-flights.bat creates timestamped backups
data/flights.json.bak-*
data/*.bak-*

# fix-mojibake.ps1 creates a backup folder per run
.mojibake-backup-*/

# Node — irrelevant today (not installed locally) but
# harmless to pre-empt if user ever installs it
node_modules/

# One-off helper scripts — promote to permanent and commit
# (remove from this list) if you reuse them
# push-5file-refresh.bat